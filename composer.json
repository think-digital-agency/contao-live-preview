    "description": "Context-aware live frontend preview sidebar for the Contao 5 backend",
    "keywords": ["contao", "contao-bundle", "contao-extension", "preview", "backend"],
    "homepage": "https://github.com/think-digital-agency/contao-live-preview",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
