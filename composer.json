{
    "name": "think-digital-agency/contao-live-preview",
    "type": "contao-bundle",
    "description": "Live preview sidebar for the Contao 5 backend — articles and content elements hot-refreshed in real time, with hover inspection and one-click edit navigation.",
    "keywords": ["contao", "contao-bundle", "contao-extension", "preview", "live preview", "frontend editor", "frontend edit helper", "frontend helper", "sidebar", "backend", "hover"],
    "homepage": "https://github.com/think-digital-agency/contao-live-preview",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Think Digital Agency",
            "homepage": "https://think-digital.agency"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "ThinkDigital\\ContaoLivePreview\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "ThinkDigital\\ContaoLivePreview\\ContaoManager\\Plugin",
        "logo": "docs/app-icon.png"
    }
}
