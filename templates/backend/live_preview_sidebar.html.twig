{# Restore sidebar width before paint to avoid flash of wrong width #}
<script>
(function(){
    var w = parseInt(localStorage.getItem('clp_sidebar_width') || '0', 10);
    if (w >= 280 && w <= 800) {
        document.documentElement.style.setProperty('--clp-saved-width', w + 'px');
    }
})();
</script>

<aside id="clp-right" role="complementary" aria-label="Live Preview">
    <div id="clp-resizer" title="Breite ziehen"></div>

    <div id="clp-toolbar">
        <span id="clp-url-display"></span>
        <button type="button" id="clp-open-tab" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Neuer Tab
        </button>
    </div>

    <iframe id="clp-frame" title="Frontend Vorschau"></iframe>
</aside>
